<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.david.waterreminder.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_water" />

    <fragment
        android:id="@+id/ProfileSetupFragment"
        android:name="com.david.waterreminder.ProfileSetupFragment"
        android:label="@string/profile_setup_title"
        tools:layout="@layout/fragment_profile_setup">

        <action
            android:id="@+id/action_ProfileSetupFragment_to_ReminderSetupFragment"
            app:destination="@id/ReminderSetupFragment" />
    </fragment>

    <fragment
        android:id="@+id/ReminderSetupFragment"
        android:name="com.david.waterreminder.ReminderSetupFragment"
        android:label="@string/reminder_setup_title"
        tools:layout="@layout/fragment_reminder_setup" />

    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.david.waterreminder.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_privacypolicy" />

    <fragment
        android:id="@+id/RemindersFragment"
        android:name="com.david.waterreminder.RemindersFragment"
        android:label="Reminders"
        tools:layout="@layout/fragment_reminders" />

    <fragment
        android:id="@+id/AnalyticsFragment"
        android:name="com.david.waterreminder.AnalyticsFragment"
        android:label="History"
        tools:layout="@layout/fragment_analytics">

        <action
            android:id="@+id/action_AnalyticsFragment_to_AllHistoryFragment"
            app:destination="@id/AllHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/AllHistoryFragment"
        android:name="com.david.waterreminder.AllHistoryFragment"
        android:label="All History"
        tools:layout="@layout/fragment_all_history" />

    <fragment
        android:id="@+id/SettingsFragment"
        android:name="com.david.waterreminder.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">

        <action
            android:id="@+id/action_SettingsFragment_to_DataFragment"
            app:destination="@id/DataFragment" />
    </fragment>

    <fragment
        android:id="@+id/ChangelogFragment"
        android:name="com.david.waterreminder.ChangelogFragment"
        android:label="@string/changelog_label"
        tools:layout="@layout/fragment_changelog" />

    <fragment
        android:id="@+id/DataFragment"
        android:name="com.david.waterreminder.DataFragment"
        android:label="@string/action_data"
        tools:layout="@layout/fragment_data" />

    <fragment
        android:id="@+id/HelpFragment"
        android:name="com.david.waterreminder.HelpFragment"
        android:label="@string/action_help"
        tools:layout="@layout/fragment_help" />

    <fragment
        android:id="@+id/AboutFragment"
        android:name="com.david.waterreminder.AboutFragment"
        android:label="@string/action_about"
        tools:layout="@layout/fragment_about">

        <action
            android:id="@+id/action_AboutFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />

        <action
            android:id="@+id/action_AboutFragment_to_ChangelogFragment"
            app:destination="@id/ChangelogFragment" />
    </fragment>
</navigation>