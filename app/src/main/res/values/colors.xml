<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
      Vision palette. Depth comes from small steps in lightness, not from shadows or lines:
      page < panel < control. values-night holds the true-black (OLED) twin of each colour.
    -->
    <color name="surface_page">#F2F2F4</color>
    <color name="surface_panel">#F9F9FA</color>
    <color name="surface_card">#E8E8EB</color>
    <color name="surface_control">#EAEAEA</color>
    <color name="surface_control_hover">#DEDEE1</color>
    <color name="text_primary">#111113</color>
    <color name="text_secondary">#505057</color>
    <color name="text_muted">#68686F</color>
    <color name="hairline">#14000000</color>
    <!-- Text and icons drawn on a brand_blue fill -->
    <color name="on_brand">#FFFFFF</color>

    <!-- Toolbar: no bar of its own, it sits on the page -->
    <color name="toolbar_background">@color/surface_page</color>

    <!-- Page backgrounds -->
    <color name="page_background">@color/surface_page</color>

    <!-- Brand / accent: sky. Darker in light mode so text and links keep their contrast. -->
    <color name="brand_blue">#0284C7</color>
    <color name="brand_orange">#FF6F00</color>
    <color name="brand_red">#F44336</color>
    <color name="brand_blue_light">#90CAF9</color>
    <color name="icon_backdrop_blue">@color/surface_panel</color>

    <!-- Splash screen: always OLED black like the icon, whatever the system theme -->
    <color name="splash_background">#000000</color>
    <color name="splash_branding_text">#83838C</color>

    <!-- Dark Blue theme surfaces (navy rather than neutral grey) -->
    <color name="blue_dark_page_background">#08213D</color>
    <color name="blue_dark_toolbar">#0F3D6B</color>
    <color name="blue_dark_icon_backdrop">#1D5490</color>
    <color name="blue_dark_surface_lowest">#051829</color>
    <color name="blue_dark_surface_low">#0C2B4C</color>
    <color name="blue_dark_surface">#11375E</color>
    <color name="blue_dark_surface_high">#164575</color>
    <color name="blue_dark_surface_highest">#1C548C</color>
    <color name="blue_dark_on_surface">#E6F0FA</color>
    <color name="blue_dark_on_surface_variant">#AFC7DE</color>
    <color name="blue_dark_outline">#4E7BA6</color>
    <color name="blue_dark_outline_variant">#2A5480</color>
    <color name="blue_dark_quick_remove_fg">#9BC8F5</color>
    <color name="blue_dark_quick_remove_bg">#17457A</color>

    <!-- Light Blue theme surfaces (blue-tinted rather than white / neutral grey) -->
    <color name="blue_light_page_background">#DCEBF9</color>
    <color name="blue_light_icon_backdrop">#B7D8F5</color>
    <color name="blue_light_surface_lowest">#F0F7FD</color>
    <color name="blue_light_surface_low">#E7F1FB</color>
    <color name="blue_light_surface">#D3E5F7</color>
    <color name="blue_light_surface_high">#C3DBF2</color>
    <color name="blue_light_surface_highest">#B0CEEC</color>
    <color name="blue_light_on_surface">#0D2440</color>
    <color name="blue_light_on_surface_variant">#33506E</color>
    <color name="blue_light_outline">#6A8AAC</color>
    <color name="blue_light_outline_variant">#A8C4DF</color>
    <color name="blue_light_toolbar">#1565C0</color>
    <color name="blue_light_quick_remove_bg">#A9CEF0</color>
    <color name="blue_light_quick_remove_fg">#0A4D8C</color>

    <!-- Quick remove chips (the add chips use brand_blue on white) -->
    <color name="quick_remove_bg">@color/surface_control</color>

    <!-- Swipe-action backgrounds -->
    <color name="swipe_edit_bg">#888888</color>

    <!-- Chart marker -->
    <color name="marker_value_text">#90CAF9</color>

    <!-- @color/page_background's day and night values written out: a values-night qualifier
         would follow the launcher's mode rather than the theme picked in the app. -->
    <color name="widget_surface_light">#FFFFFF</color>
    <color name="widget_text_light">#1A2535</color>
    <color name="widget_text_variant_light">#5A6B7D</color>

    <color name="widget_surface_dark">#121212</color>
    <color name="widget_text_dark">#ECF1F6</color>
    <color name="widget_text_variant_dark">#A6B4C2</color>

    <!-- Grey rather than a theme colour: one progress track for all four palettes. -->
    <color name="widget_progress_track">#42808080</color>

    <!-- Press feedback on a quick-log chip: white at low alpha, over the chip's brand blue. -->
    <color name="widget_chip_ripple">#59FFFFFF</color>
</resources>