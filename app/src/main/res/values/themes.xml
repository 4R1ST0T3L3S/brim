<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Light and dark surfaces resolve through values / values-night. -->
    <style name="Base.Theme.WaterReminder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="pageBackground">@color/page_background</item>
        <item name="toolbarBackground">@color/toolbar_background</item>
        <item name="iconBackdrop">@color/icon_backdrop_blue</item>
        <item name="quickAddBackground">@color/surface_control</item>
        <item name="quickAddForeground">@color/text_primary</item>
        <item name="quickRemoveBackground">@color/quick_remove_bg</item>
        <item name="quickRemoveForeground">@color/text_primary</item>

        <!-- Vision palette (values / values-night): neutral greys, one sky accent. -->
        <item name="android:colorBackground">@color/surface_page</item>
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/surface_control</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_blue</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/surface_control</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorTertiary">@color/brand_blue</item>
        <item name="colorOnTertiary">@color/on_brand</item>
        <item name="colorSurface">@color/surface_page</item>
        <item name="colorSurfaceVariant">@color/surface_control</item>
        <item name="colorSurfaceContainerLowest">@color/surface_page</item>
        <item name="colorSurfaceContainerLow">@color/surface_panel</item>
        <item name="colorSurfaceContainer">@color/surface_panel</item>
        <item name="colorSurfaceContainerHigh">@color/surface_control</item>
        <item name="colorSurfaceContainerHighest">@color/surface_control_hover</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/text_muted</item>
        <item name="colorOutlineVariant">@color/hairline</item>
        <item name="colorBackgroundFloating">@color/surface_panel</item>
        <item name="android:colorBackgroundFloating">@color/surface_panel</item>

        <!-- Geist everywhere: plain views read fontFamily, Material views their text appearances. -->
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.WaterReminder.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.WaterReminder.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.WaterReminder.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.WaterReminder.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.WaterReminder.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.WaterReminder.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.WaterReminder.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.WaterReminder.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.WaterReminder.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.WaterReminder.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.WaterReminder.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.WaterReminder.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.WaterReminder.LabelSmall</item>

        <!-- Transparent system bars for edge-to-edge; the tinted themes inherit these too. -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
    </style>

    <!-- Material 3 type scale, set in Geist. -->
    <style name="TextAppearance.WaterReminder.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.WaterReminder.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.WaterReminder.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
    </style>

    <!-- Toolbar: screen title on the page itself, Vision's 20sp semibold with tight tracking. -->
    <style name="TextAppearance.WaterReminder.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/geist_semibold</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.WaterReminder.ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/geist</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Flat button: control colour, no outline, no elevation, 52dp tall. -->
    <style name="Widget.WaterReminder.FlatButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/surface_control</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Tiny bold uppercase section label with wide tracking. -->
    <style name="Widget.WaterReminder.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/geist_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Theme.WaterReminder" parent="Base.Theme.WaterReminder">
        <!-- Splash (Android 12+; older versions ignore it): black, the bare drop, the tagline. Only the
             manifest theme reaches the splash, so the tinted themes below don't need it. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">@drawable/splash_branding</item>
    </style>

    <!--
      Dark Blue: a dark theme whose surfaces are navy instead of neutral grey. Material's surface
      roles are overridden alongside the app's own attributes because cards, dialogs and menus are
      styled through colorSurface* rather than through pageBackground.
    -->
    <style name="Base.Theme.WaterReminder.BlueDark">
        <item name="pageBackground">@color/blue_dark_page_background</item>
        <item name="toolbarBackground">@color/blue_dark_toolbar</item>
        <item name="iconBackdrop">@color/blue_dark_icon_backdrop</item>
        <item name="quickRemoveBackground">@color/blue_dark_quick_remove_bg</item>
        <item name="quickRemoveForeground">@color/blue_dark_quick_remove_fg</item>

        <item name="android:colorBackground">@color/blue_dark_page_background</item>
        <item name="colorSurface">@color/blue_dark_surface_low</item>
        <item name="colorSurfaceVariant">@color/blue_dark_surface_high</item>
        <item name="colorSurfaceContainerLowest">@color/blue_dark_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/blue_dark_surface_low</item>
        <item name="colorSurfaceContainer">@color/blue_dark_surface</item>
        <item name="colorSurfaceContainerHigh">@color/blue_dark_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/blue_dark_surface_highest</item>
        <item name="colorOnSurface">@color/blue_dark_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/blue_dark_on_surface_variant</item>
        <item name="colorOutline">@color/blue_dark_outline</item>
        <item name="colorOutlineVariant">@color/blue_dark_outline_variant</item>
        <!-- AppCompat AlertDialogs tint their window background from this rather than colorSurface*. -->
        <item name="colorBackgroundFloating">@color/blue_dark_surface_high</item>
        <item name="android:colorBackgroundFloating">@color/blue_dark_surface_high</item>
    </style>

    <style name="Theme.WaterReminder.BlueDark" parent="Base.Theme.WaterReminder.BlueDark" />

    <!--
      Light Blue: a light theme tinted blue throughout — a blue app bar rather than Light's near
      black navy, a blue page and blue surfaces. The quick-remove chip is deepened along with the
      page, or it would wash out against it.
    -->
    <style name="Base.Theme.WaterReminder.BlueLight">
        <item name="pageBackground">@color/blue_light_page_background</item>
        <item name="toolbarBackground">@color/blue_light_toolbar</item>
        <item name="iconBackdrop">@color/blue_light_icon_backdrop</item>
        <item name="quickRemoveBackground">@color/blue_light_quick_remove_bg</item>
        <item name="quickRemoveForeground">@color/blue_light_quick_remove_fg</item>

        <item name="android:colorBackground">@color/blue_light_page_background</item>
        <item name="colorSurface">@color/blue_light_surface_low</item>
        <item name="colorSurfaceVariant">@color/blue_light_surface_high</item>
        <item name="colorSurfaceContainerLowest">@color/blue_light_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/blue_light_surface_low</item>
        <item name="colorSurfaceContainer">@color/blue_light_surface</item>
        <item name="colorSurfaceContainerHigh">@color/blue_light_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/blue_light_surface_highest</item>
        <item name="colorOnSurface">@color/blue_light_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/blue_light_on_surface_variant</item>
        <item name="colorOutline">@color/blue_light_outline</item>
        <item name="colorOutlineVariant">@color/blue_light_outline_variant</item>
        <item name="colorBackgroundFloating">@color/blue_light_surface_low</item>
        <item name="android:colorBackgroundFloating">@color/blue_light_surface_low</item>
    </style>

    <style name="Theme.WaterReminder.BlueLight" parent="Base.Theme.WaterReminder.BlueLight" />

    <!--
      Quick-log chip on the home-screen widget: the home screen's own add-button colours, which
      quickAddBackground / quickAddForeground set once on the base theme and no tinted theme
      overrides. Fixed here rather than swapped per palette for that reason.
    -->
    <style name="Widget.WaterReminder.WidgetChip" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Licenses & Credits screen: a section heading and the text under it. -->
    <style name="Widget.WaterReminder.CreditsHeading" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.WaterReminder.CreditsBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:autoLink">web</item>
    </style>

    <style name="Widget.WaterReminder.CreditsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="PopupTheme" parent="ThemeOverlay.AppCompat.Light" />
</resources>
