<?xml version="1.0" encoding="utf-8"?>
<!-- One grey bar for all four themes: it reads on a white card and on a navy one, which a
     RemoteViews needs, since it can't swap a progressDrawable before API 31. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_progress_track" />
            <corners android:radius="@dimen/widget_bar_radius" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/brand_blue" />
                <corners android:radius="@dimen/widget_bar_radius" />
            </shape>
        </clip>
    </item>
</layer-list>
