<?xml version="1.0" encoding="utf-8"?>
<!-- One bar for all four themes: a grey the track reads as on both a white card and a navy one,
     with the brand blue over it. Swapping a progressDrawable per theme isn't possible from a
     RemoteViews before API 31, and the bar is the one element that doesn't need it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_progress_track" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/brand_blue" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
