    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Drop body -->
    <path android:pathData="
        M54,12
        C46,22 28,52 28,72
        A26,26 0 0,0 80,72
        C80,52 62,22 54,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="12"
