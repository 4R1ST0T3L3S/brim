            C46,22 28,52 28,72
            A26,26 0 0,0 80,72
            C80,52 42,22 54,12 Z" />
        <path android:pathData="M47,20 C42,18 36,28 39,40 C41,47 50,46 53,35 C55,27 51,19 47,20 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="45"
                    android:centerY="32"
                    android:gradientRadius="14">
                    <item android:offset="0.0" android:color="#C8FFFFFF"/>
                    <item android:offset="0.6" android:color="#60FFFFFF"/>
                    <item android:offset="1.0" android:color="#00FFFFFF"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>

</vector>
