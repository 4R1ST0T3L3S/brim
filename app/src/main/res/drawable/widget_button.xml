<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick-log chip; one drawable for every theme, for the reason Widget.WaterReminder.WidgetChip
  gives. A ripple rather than a flat shape: the launcher draws it before the broadcast is sent,
  so a cold start can't look like the tap did nothing — which is how an amount gets logged twice.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_chip_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/widget_chip_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_blue" />
            <corners android:radius="@dimen/widget_chip_radius" />
        </shape>
    </item>
</ripple>
