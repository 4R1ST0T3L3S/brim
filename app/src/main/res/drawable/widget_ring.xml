<?xml version="1.0" encoding="utf-8"?>
<!--
  The one-row widget's progress ring, set as a horizontal ProgressBar's progressDrawable so
  setProgressBar drives it exactly as it drives widget_progress. ProgressBar sets the level of the
  progress layer, a ring with useLevel sweeps by it, and the rotate moves the start from 3 o'clock
  to 12. 17 + 5 dp is the 22 dp radius of the 44 dp view. Same two colours in every theme, for
  the reason widget_progress gives; ring shapes have no round caps, so the ends are square.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape
            android:innerRadius="17dp"
            android:shape="ring"
            android:thickness="5dp"
            android:useLevel="false">
            <solid android:color="@color/widget_progress_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="270">
            <shape
                android:innerRadius="17dp"
                android:shape="ring"
                android:thickness="5dp"
                android:useLevel="true">
                <solid android:color="@color/brand_blue" />
            </shape>
        </rotate>
    </item>
</layer-list>
