<?xml version="1.0" encoding="utf-8"?>
<!--
  Home, in Vision's style: one big light-weight number, a thin progress bar, a single grid of
  amounts with an Add / Remove switch, and two cards leading to History and Reminders. The
  screen title ("Today" and the date) lives in the toolbar, so nothing here repeats it.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageBackground"
    tools:context=".FirstFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Today's total: huge, light, tabular digits with a small muted unit beside it. -->
        <LinearLayout
            android:id="@+id/row_intake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_intake_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_light"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.05"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="88sp"
                tools:text="1.250" />

            <TextView
                android:id="@+id/text_intake_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/geist_bold"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                tools:text="ml" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_intake_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="of 2,000 ml · 63%" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_water"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:max="100"
            app:indicatorColor="@color/brand_blue"
            app:indicatorTrackGapSize="0dp"
            app:trackColor="@color/surface_control"
            app:trackCornerRadius="3dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="6dp"
            tools:progress="63" />

        <!-- Invisible until today has a drink (it keeps its space so nothing below jumps);
             tapping it slides up today's drinks (TodayDrinksSheet). -->
        <TextView
            android:id="@+id/text_last_drink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:drawableEnd="@drawable/ic_chevron_up_small"
            android:drawablePadding="4dp"
            android:drawableTint="@color/brand_blue"
            android:fontFamily="@font/geist_semibold"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/brand_blue"
            android:textSize="13sp"
            android:visibility="invisible"
            tools:text="Last drink 14:32"
            tools:visibility="visible" />

        <!-- Add / Remove: one switch instead of two rows of buttons. -->
        <LinearLayout
            android:id="@+id/segment_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/btn_mode_add"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_on"
                android:fontFamily="@font/geist_semibold"
                android:gravity="center"
                android:text="@string/home_mode_add"
                android:textColor="@color/on_brand"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_mode_remove"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:fontFamily="@font/geist_semibold"
                android:gravity="center"
                android:text="@string/home_mode_remove"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Amount grid, two per row; built in code (FirstFragment.rebuildQuickButtons). -->
        <LinearLayout
            android:id="@+id/container_quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/text_goal_reached"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/geist_semibold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/home_goal_reached"
            android:textColor="@color/brand_blue"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- History and Reminders, where the two floating buttons used to be. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    style="@style/Widget.WaterReminder.SectionLabel"
                    android:text="@string/home_history_label" />

                <!-- Last 7 days, today last; bars built in code. -->
                <LinearLayout
                    android:id="@+id/container_mini_bars"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="12dp"
                    android:gravity="bottom"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/text_history_avg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Avg 1,780 ml" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_reminders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    style="@style/Widget.WaterReminder.SectionLabel"
                    android:text="@string/home_reminder_label" />

                <TextView
                    android:id="@+id/text_next_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/geist_light"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    tools:text="16:30" />

                <TextView
                    android:id="@+id/text_reminder_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Today" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
