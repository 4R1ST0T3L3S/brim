<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageBackground"
    tools:context=".FirstFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <TextView
            android:id="@+id/title_water_reminder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_intake_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_intake_label"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_water_reminder" />

        <!-- One 500 ml bottle per 500 ml of the goal, filled based on current intake.
             Rows are built in code (see FirstFragment.updateBottlesUI) because the count
             follows the goal — 3 bottles at the 1500 ml minimum, 20 at a 10 000 ml goal. -->
        <LinearLayout
            android:id="@+id/container_bottles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_intake_label" />

        <ProgressBar
            android:id="@+id/progress_water"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="?attr/colorSurfaceVariant"
            android:progressTint="@color/brand_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/container_bottles" />

        <!-- Shares the total's row, so it costs no height. Gone until today has a drink; tapping
             it slides up the rest of today's drinks (TodayDrinksSheet). Drawn as a link — blue
             and bold like History's "View all history →", with a chevron pointing the way the
             sheet comes — because plain grey text gives no hint that it can be tapped. -->
        <TextView
            android:id="@+id/text_last_drink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/ic_clock_small"
            android:drawableEnd="@drawable/ic_chevron_up_small"
            android:drawablePadding="4dp"
            android:drawableTint="@color/brand_blue"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/brand_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBaseline_toBaselineOf="@id/text_intake_amount"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Last drink 14:32"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_intake_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:text="@string/home_intake_amount"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/text_last_drink"
            app:layout_goneMarginStart="0dp"
            app:layout_constraintTop_toBottomOf="@id/progress_water" />

        <!-- Quick Add label -->
        <TextView
            android:id="@+id/text_quick_add_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_quick_add_label"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_intake_amount" />

        <!-- Quick Add buttons (built dynamically, sorted by value) -->
        <com.david.waterreminder.FlowLayout
            android:id="@+id/container_quick_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_quick_add_label" />

        <!-- Quick Remove label -->
        <TextView
            android:id="@+id/text_quick_remove_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_quick_remove_label"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/container_quick_add" />

        <!-- Quick Remove buttons (built dynamically, sorted by value) -->
        <com.david.waterreminder.FlowLayout
            android:id="@+id/container_quick_remove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_quick_remove_label" />

        <TextView
            android:id="@+id/text_goal_reached"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/home_goal_reached"
            android:textColor="@color/brand_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/container_quick_remove"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
