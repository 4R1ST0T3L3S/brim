<?xml version="1.0" encoding="utf-8"?>
<!--
  The one-row widget: widget_water laid on its side. The ring carries the percentage, so the goal
  line beside the total drops it. Every id the provider shares with widget_water means the same
  thing here, so one redraw fills either layout.

  Centred vertically with no vertical padding: a launcher row runs from about 56 to 120 dp, and
  the 44 dp ring is the tallest thing in it.

  Text, colours and the half-full ring are the picker's sample, as in widget_water; the provider
  overwrites all of them on every redraw.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Opens the app, as widget_water's header does; the chips beside it log. -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <!-- The horizontal style caps a ProgressBar at 16 dp tall; the four limits undo it. -->
            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:maxWidth="44dp"
                android:maxHeight="44dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:progress="50"
                android:progressDrawable="@drawable/widget_ring" />

            <TextView
                android:id="@+id/widget_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text_light"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/widget_preview_percent" />
        </FrameLayout>

        <!-- Dropped at the narrowest band, where it would take the last chip's room. -->
        <LinearLayout
            android:id="@+id/widget_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text_light"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/widget_preview_total" />

            <TextView
                android:id="@+id/widget_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text_variant_light"
                android:textSize="12sp"
                android:text="@string/widget_preview_row_goal" />
        </LinearLayout>
    </LinearLayout>

    <!-- One slot per widgetAmounts() entry, as in widget_water. Each chip is match_parent tall in
         a wrap_content row, so all take the tallest one's height: a label shrunk to fit
         ("+1250 ml") would otherwise leave its chip shorter than its neighbours. -->
    <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_button_0"
            style="@style/Widget.WaterReminder.WidgetChip"
            android:layout_height="match_parent"
            android:text="@string/widget_preview_add_small" />

        <TextView
            android:id="@+id/widget_button_1"
            style="@style/Widget.WaterReminder.WidgetChip"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_add_medium" />

        <!-- Hidden by default: the picker draws at four cells on any grid, and only a four-column
             one has room for three (ROW); two read on a five-column one too. -->
        <TextView
            android:id="@+id/widget_button_2"
            style="@style/Widget.WaterReminder.WidgetChip"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
