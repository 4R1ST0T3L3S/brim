<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Grey edit background, revealed on right swipe -->
    <LinearLayout
        android:id="@+id/edit_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/swipe_edit_bg"
        android:gravity="center_vertical|start"
        android:paddingStart="24dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="@color/white"
            android:contentDescription="Edit" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Red delete background, revealed on left swipe -->
    <LinearLayout
        android:id="@+id/delete_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/brand_red"
        android:gravity="center_vertical|end"
        android:paddingEnd="24dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/white"
            android:contentDescription="Delete" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- White foreground — slides on swipe -->
    <LinearLayout
        android:id="@+id/foreground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/page_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_reminder_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                android:textColor="?attr/colorOnSurface"
                android:text="🔔  10:00" />

            <TextView
                android:id="@+id/text_reminder_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Daily"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_type_chip"
                android:clickable="true"
                android:focusable="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_reminder_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

    </LinearLayout>

</FrameLayout>
