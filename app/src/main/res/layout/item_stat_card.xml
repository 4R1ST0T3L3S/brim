<?xml version="1.0" encoding="utf-8"?>
<!-- One History stat: tiny uppercase label, big light number, small muted unit beside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/stat_label"
        style="@style/Widget.WaterReminder.SectionLabel"
        tools:text="Daily average" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stat_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_light"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            tools:text="1780" />

        <TextView
            android:id="@+id/stat_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/geist_bold"
            android:textAllCaps="true"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            tools:text="ml" />
    </LinearLayout>
</LinearLayout>
