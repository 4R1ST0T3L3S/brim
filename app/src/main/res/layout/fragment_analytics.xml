<?xml version="1.0" encoding="utf-8"?>
<!--
  History, in Vision's style. The screen title lives in the toolbar. analytics_content is the view
  rendered into the shared PNG, so the two buttons under it (All history, Edit a day) sit outside
  it and never end up in the picture.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/analytics_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/analytics_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/pageBackground"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp">

            <!-- Section label, with sharing as a round button on the same line. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/label_last_7"
                    style="@style/Widget.WaterReminder.SectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/analytics_last_7_days" />

                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_round_control"
                    android:contentDescription="@string/analytics_share"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_share_nodes"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- The week, in a panel: rounded bars, no axis clutter, the goal as one quiet line. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_panel"
                android:paddingStart="12dp"
                android:paddingTop="16dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/bar_chart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />
            </FrameLayout>

            <!-- Stats as metric cards over the whole history: tiny label, big light number, small muted unit. -->
            <TextView
                style="@style/Widget.WaterReminder.SectionLabel"
                android:layout_marginTop="24dp"
                android:text="@string/analytics_all_time" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stat_avg"
                    layout="@layout/item_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/stat_best"
                    layout="@layout/item_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stat_goal_days"
                    layout="@layout/item_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- Only when a personal goal is set; the card beside it then spans the row. -->
                <include
                    android:id="@+id/stat_personal_goal_days"
                    layout="@layout/item_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Flat buttons instead of a link and a floating button. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/text_view_all_history"
                style="@style/Widget.WaterReminder.FlatButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/analytics_all_history" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fab_edit_day"
                style="@style/Widget.WaterReminder.FlatButton"
                android:layout_width="0dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/analytics_edit_day_action" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
