<?xml version="1.0" encoding="utf-8"?>
<!-- Geist (SIL Open Font License 1.1, see GEIST-OFL.txt at the repository root). Static weights
     converted from the latin WOFF2 subset; the android: and app: attributes cover API 24-25 too. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/geist_light"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/geist_light"
        app:fontStyle="normal"
        app:fontWeight="300" />
    <font
        android:font="@font/geist_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/geist_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/geist_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/geist_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/geist_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/geist_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
