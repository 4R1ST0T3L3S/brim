<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude tour flag so reinstalling always shows the guide tour again -->
        <exclude domain="sharedpref" path="tour_prefs.xml"/>
        <!-- Device bookkeeping and today's drink times: never meant to leave the device -->
        <exclude domain="sharedpref" path="transient_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude tour flag so reinstalling always shows the guide tour again -->
        <exclude domain="sharedpref" path="tour_prefs.xml"/>
        <!-- Device bookkeeping and today's drink times: never meant to leave the device -->
        <exclude domain="sharedpref" path="transient_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>