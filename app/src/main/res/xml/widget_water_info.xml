<?xml version="1.0" encoding="utf-8"?>
<!--
  Sizes are in Android's cell formula, 70n - 30: 250dp is the 4 cells it is placed at, 110dp the
  2 it resizes down to. What the card does on the way down is WidgetSizeBand's business.

  Width only: the content is a fixed stack, so a taller card is dead space and a shorter one
  clips. A launcher may honour resizeMode or ignore it — it is a request, not a lock.

  updatePeriodMillis is the floor Android allows, and only a backstop: updateWaterWidgets redraws
  the moment anything changes, so this catches nothing but midnight passing unattended.

  initialLayout is not previewLayout: sample numbers sell the widget in the picker and lie on a
  placed one.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_water_initial"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="250dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_water"
    android:resizeMode="horizontal"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
