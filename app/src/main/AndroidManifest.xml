<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Health Connect's library wants Android 8; the app runs from 7 and skips it below 9. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <!-- Health Connect sync (opt-in): each drink is written as Hydration. Granted in Health Connect. -->
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />

    <!-- Lets the library find the Health Connect app on Android 13 and lower. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="true"
        android:backupAgent=".WaterBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaterReminder">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WaterReminder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Privacy policy for Health Connect's permission screen. Exported, but it only shows text. -->
        <activity
            android:name=".HealthConnectPrivacyActivity"
            android:exported="true"
            android:label="@string/second_fragment_label">
            <!-- Android 13 and lower. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14 and up. Only the system holds START_VIEW_PERMISSION_USAGE. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".HealthConnectPrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- All three are fired only by PendingIntents this app created (an alarm, a notification
             button), which run with our identity against an explicit component — so neither
             needs to be reachable by anything else. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".QuickLogReceiver"
            android:exported="false" />

        <receiver
            android:name=".IdleReminderReceiver"
            android:exported="false" />

        <!-- The AppWidget framework addresses this component explicitly and the quick-log
             buttons on the widget come back to it through PendingIntents this app created, so
             like the receivers above it needs to be reachable by nothing else. -->
        <receiver
            android:name=".WaterWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_water_info" />
        </receiver>

        <!-- The one-row widget, a second entry in the picker. Its log buttons go back to
             WaterWidgetProvider above; this one only draws. -->
        <receiver
            android:name=".WaterRowWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_water_row_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.AIRPLANE_MODE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Both are exempt from the implicit-broadcast limits, and both invalidate every
                     RTC fire time already armed. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>